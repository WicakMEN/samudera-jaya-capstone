AI_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Opsional untuk fitur OCR Nota Belanja (dilanjutkan oleh Faiz):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Fallback opsional jika Gemini Vision terkena rate limit (429) atau gangguan:
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OCR_MIN_INTERVAL_SECONDS=0.5
